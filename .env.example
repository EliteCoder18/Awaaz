# Server-only. Copy to .env.local for local dev; on Vercel add the same names
# under Project → Settings → Environment Variables. Never use a VITE_ prefix.

# Required for AI features (safety check, explanations, intent, voice, conversation).
OPENAI_API_KEY=
# Optional overrides (cheap defaults are used when empty).
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_CONVERSATION_MODEL=

# Optional: legacy Gemini question classifier.
GEMINI_API_KEY=
