# Server-only. Copy to .env.local and add a restricted Google AI Studio key.
# Never use VITE_GEMINI_API_KEY, paste a secret in browser code, or commit .env.local.
GEMINI_API_KEY=

# Server-only OpenAI conversation understanding. Never use a VITE_* secret.
OPENAI_API_KEY=
OPENAI_CONVERSATION_MODEL=gpt-4.1-mini
