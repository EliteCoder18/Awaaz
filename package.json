{
  "name": "awaaz-bitcoin-verifier",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sdk": "vite build --config vite.sdk.config.ts && tsc -p tsconfig.sdk.json",
    "test:sdk": "node scripts/sdk-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "test:e2e:production": "AWAAZ_E2E_MODE=production playwright test --project=chromium",
    "format:check": "prettier --check src server e2e *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource/lora": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/yatra-one": "5.3.0",
    "bitcoinjs-lib": "7.0.1",
    "framer-motion": "14.0.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.52.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^27.0.0",
    "prettier": "3.9.9",
    "qrcode": "1.5.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
